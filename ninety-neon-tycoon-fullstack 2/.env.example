# Local development uses SQLite automatically when DATABASE_URL is omitted.
# Vercel MUST use persistent Supabase Postgres. Copy the transaction-pooler URL.
# Example: postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Vercel profile photo storage (server-side only; never prefix these with VITE_ or NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
